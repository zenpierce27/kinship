{
  "name": "kinship",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cli": "npm run --workspace @kinship/cli",
    "web": "npm run --workspace @kinship/web",
    "dev": "npm run dev --workspace @kinship/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test:run --workspace @kinship/cli"
  }
}
